# ==============================================================================
# Immich Experimental / Apple Silicon Isolated Environment Variables
# ==============================================================================
# This configuration guarantees ZERO interference with your production Immich:
# - Production Ports: 2283 (Server), 5432 (Postgres), 6379 (Redis), 8901 (Power Tools)
# - Isolated Ports:   3283 (Server), 5433 (Postgres), 6380 (Redis), 3004 (ML)
# - Isolated Docker Network: immich_exp_network (disjoint from immich_default)
# - Bind Address: Loopback 127.0.0.1 ONLY (no LAN exposure)
# ==============================================================================

# Server Network & Host Binding
IMMICH_HOST=127.0.0.1
IMMICH_PORT=3283
SERVER_PORT=3283

# Machine Learning Service (Native Apple Silicon with CoreML)
IMMICH_ML_PORT=3004
MACHINE_LEARNING_PORT=3004
IMMICH_MACHINE_LEARNING_URL=http://127.0.0.1:3004
MACHINE_LEARNING_CACHE_FOLDER=${HOME}/.cache/immich_ml
MACHINE_LEARNING_EXECUTION_PROVIDERS=["CoreMLExecutionProvider","CPUExecutionProvider"]

# Isolated Storage Directory (Keeps experimental data away from production photos)
IMMICH_MEDIA_LOCATION=${HOME}/immich-experimental-data
UPLOAD_LOCATION=${HOME}/immich-experimental-data

# Isolated PostgreSQL Database (Dedicated container immich_exp_postgres)
DB_HOSTNAME=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich_exp
DB_VECTOR_EXTENSION=vectorchord

# Isolated Cache (Dedicated container immich_exp_redis)
REDIS_HOSTNAME=127.0.0.1
REDIS_PORT=6380
REDIS_DBINDEX=0

# Hardware Acceleration for Video Transcoding (Apple VideoToolbox)
IMMICH_TRANSCODING_HARDWARE_ACCELERATION=videotoolbox
IMMICH_LOG_LEVEL=info
